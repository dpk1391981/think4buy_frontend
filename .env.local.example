## =============================================================================
## Think4BuySale Frontend — Environment Variables
## =============================================================================
## Copy this file:
##   Mac/Linux : cp .env.local.example .env.local
##   Windows   : copy .env.local.example .env.local
##
## IMPORTANT — Two types of variables:
##   NEXT_PUBLIC_*  → sent to browser (keep non-sensitive only)
##   Everything else → server-side only (safe for secrets)
## =============================================================================

# ── Public (visible in browser bundle) ───────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Think4BuySale
NEXT_PUBLIC_APP_URL=http://localhost:3000

# In DEV:  http://localhost:3000  — all API calls go through /api/q handler
# In PROD: https://think4buysale.com — never the real backend URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Backend *origin* for serving uploaded images (no /api/v1 suffix).
# Used by OptimizedImage, imageUtils, etc. to resolve relative /uploads/ paths.
# Dev:  http://localhost:3001
# Prod: https://reales-api.vtechxhub.com  (or your backend's public domain)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Server-side Only (never sent to browser) ─────────────────────────────────
# Direct URL to NestJS backend (only accessible from Next.js server process).
# On Vercel (cloud): must be the public backend URL since there's no shared localhost.
# Dev:    http://localhost:3001/api/v1
# Prod:   https://reales-api.vtechxhub.com/api/v1
# Vercel: https://reales-api.vtechxhub.com/api/v1  ← REQUIRED on Vercel
# If unset, the BFF falls back to NEXT_PUBLIC_API_BASE_URL+/api/v1 automatically.
BACKEND_INTERNAL_URL=http://localhost:3001/api/v1

# Must match backend .env BFF_INTERNAL_SECRET
BFF_INTERNAL_SECRET=dev-bff-secret

# Must match backend .env INTERNAL_API_KEY / INTERNAL_API_SECRET
INTERNAL_API_KEY=dev-api-key
INTERNAL_API_SECRET=dev-api-secret

# Must match backend .env CACHE_INVALIDATE_SECRET
CACHE_INVALIDATE_SECRET=dev-cache-secret

# Redis for BFF-side response cache (optional in dev — skip if no Redis)
# Uses DB 1 to avoid conflicts with backend BullMQ (DB 0)
REDIS_URL=redis://localhost:6379/1
